// Stage 3: central parameters; notebook names retained for comparability.
params {
    // Inputs and outputs
    input = 'samplesheet.csv'
    outdir = 'results'
    kb_index = '' // optional alias; otherwise use index below
    reference_cache = 'references/cache/ensembl108-v1'
    sample_id = 'pbmc_1k_v3'
    samplesheet = 'samplesheet.csv'
    chemistry = '10xv3'
    workflow = 'standard'
    threads = 4
    fastqc_threads = 4
    fastqc_job_memory = '2 GB'
    fastqc_memory_mb = 512
    sort_memory = '4G'  // bustools sorting allocation, NOT a whole-job RAM cap
    seed = 42
    test_pairs_per_lane = 500000
    download_retries = 5
    raw_url = 'https://cf.10xgenomics.com/samples/cell-exp/3.0.0/pbmc_1k_v3/pbmc_1k_v3_fastqs.tar'
    raw_archive = 'work/downloads/pbmc_1k_v3_fastqs.tar'
    raw_dir = 'data/raw'
    test_dir = 'data/test'
    reference_url = 'https://github.com/pachterlab/kallisto-transcriptome-indices/releases/download/v1/human_index_standard.tar.xz'
    reference_archive = 'work/downloads/human_index_standard.tar.xz'
    reference_dir = 'references/human_ensembl108'
    index = 'references/human_ensembl108/index.idx'
    t2g = 'references/human_ensembl108/t2g.txt'
    full_counts = 'results/full/kb'
    test_counts = 'results/test/kb'
    full_fastqc = 'results/full/fastqc'
    test_fastqc = 'results/test/fastqc'
    // Stage 2 notebook parameters (full sample; exploratory QC)
    analysis_input = 'results/full/kb/counts_unfiltered/adata.h5ad'
    analysis_output = 'results/annotated.h5ad'
    analysis_dir = 'results/stage2'
    qc_min_genes = 200
    qc_max_genes = 5000
    qc_min_counts = 1000
    qc_max_counts = 30000
    qc_max_pct_mt = 20
    qc_gene_min_cells = 3
    normalization_target = 10000
    hvg_n_top_genes = 2000
    hvg_flavor = 'seurat'
    pca_components = 50
    pca_scale_clip = 10
    neighbors_n_pcs = 20
    neighbors_n_neighbors = 15
    leiden_resolution = 0.6
    leiden_iterations = 2
    umap_min_dist = 0.3
    marker_method = 'wilcoxon'
    marker_top_n = 4
    celltypist_model = 'references/celltypist/Immune_All_Low.pkl'
    celltypist_model_url = 'https://celltypist.cog.sanger.ac.uk/models/Pan_Immune_CellTypist/v2/Immune_All_Low.pkl'
    celltypist_model_sha256 = '290874d35dac039d4c9218c343fde4aac1077709b72a331ce7266f6828c36502'
    celltypist_overcluster_resolution = 5.0
    celltypist_min_prop = 0.5
    pbmc_markers = 'CD3E,IL7R,CD8A,MS4A1,CD79A,GNLY,NKG7,CD14,LYZ,FCGR3A,FCER1A,CST3'
    review_markers = 'CD3D,CD3E,TRAC,TRDC,TRGC2,CD8B,KLRD1,FCER1G,TYROBP,SLC4A10,KLRB1,LILRA4,CLEC4C,TCF4,GZMB,CD1C,CCR7,TCF7,LEF1,S100A8,S100A9'
    // Optional doublet detection: report by default; removal requires explicit opt-in.
    run_doublets = true
    remove_doublets = false
    doublet_expected_rate = 0.01
    doublet_sim_ratio = 2.0
    doublet_threshold = 0.0 // 0 = automatic Scrublet threshold
    doublet_n_pcs = 30
    mt_prefix = 'MT-'
    plot_bins = 60
    plot_dpi = 160
    // Resource classes and immutable tool images
    light_cpus = 2
    analysis_cpus = 2
    light_memory = '1 GB'
    count_memory = '5 GB'
    analysis_memory = '3 GB'
    fastqc_container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0@sha256:e194048df39c3145d9b4e0a14f4da20b59d59250465b6f2a9cb698445fd45900'
    container_kallisto = '/usr/local/bin/kallisto'
    kb_container = 'rna-seq-kb:0.30.2-k0.51.1-1'
    multiqc_container = 'quay.io/biocontainers/multiqc:1.27--pyhdfd78af_0@sha256:a024b23be16fa3f3919ef018741478a7a3bfaaed0222369dff59abaf28316149'
    analysis_container = 'rna-seq-analysis:0.3.0'
}

manifest {
    name = 'riiptide/rna-seq'
    version = '0.3.0'
    nextflowVersion = '>=26.04.0'
}
workDir = 'work/nextflow-tasks'
process {
    errorStrategy = 'terminate'
    withLabel: light {
        cpus = params.light_cpus
        memory = params.light_memory
    }
    withLabel: count {
        cpus = params.threads
        memory = params.count_memory
        maxForks = 1
    }
    withLabel: analysis {
        cpus = params.analysis_cpus
        memory = params.analysis_memory
        maxForks = 1
    }
    withName: FASTQC {
        container = params.fastqc_container
        cpus = params.fastqc_threads
        memory = params.fastqc_job_memory
    }
    withName: KB_COUNT { container = params.kb_container }
    withName: KB_REF { container = params.kb_container }
    withName: 'TO_ANNDATA|SCANPY_QC|SCANPY_CLUSTER|CELLTYPIST' { container = params.analysis_container }
    withName: MULTIQC { container = params.multiqc_container }
}
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '--platform linux/amd64'
        params.celltypist_model = '/opt/conda/models/Immune_All_Low.pkl'
    }
    test {
        params.input = 'tests/samplesheet_test.csv'
        params.outdir = 'results/test-pipeline'
        params.qc_min_genes = 50
        params.qc_min_counts = 100
        params.qc_max_pct_mt = 30
    }
    manual_mac {
        params {
    // Stage 1 Mac binary: the bundled standard-k build reads the v1 reference.
    kallisto = 'work/envs/stage1/lib/python3.11/site-packages/kb_python/bins/darwin/m1/kallisto/kallisto'
    bustools = 'work/envs/native-count/bin/bustools'
    count_library_path = 'work/envs/native-count/lib'
        }
    }
    // Scaffold only: requires Apptainer, a cluster queue, and a published analysis image.
    slurm {
        process.executor = 'slurm'
        apptainer.enabled = true
        apptainer.autoMounts = true
        params.celltypist_model = '/opt/conda/models/Immune_All_Low.pkl'
    }
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
