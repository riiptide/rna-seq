// Stage 1: Nextflow reads configuration only; biological tools run by hand.
params {
    sample_id = 'pbmc_1k_v3'
    samplesheet = 'samplesheet.csv'
    chemistry = '10xv3'
    workflow = 'standard'
    threads = 4
    fastqc_threads = 4
    fastqc_memory_mb = 512
    sort_memory = '4G'  // bustools sorting allocation, NOT a whole-job RAM cap
    // Stage 1 Mac binary: the bundled standard-k build reads the v1 reference.
    kallisto = 'work/envs/stage1/lib/python3.11/site-packages/kb_python/bins/darwin/m1/kallisto/kallisto'
    bustools = 'work/envs/native-count/bin/bustools'
    count_library_path = 'work/envs/native-count/lib'
    seed = 42
    test_pairs_per_lane = 500000
    download_retries = 5
    raw_url = 'https://cf.10xgenomics.com/samples/cell-exp/3.0.0/pbmc_1k_v3/pbmc_1k_v3_fastqs.tar'
    raw_archive = 'work/downloads/pbmc_1k_v3_fastqs.tar'
    raw_dir = 'data/raw'
    test_dir = 'data/test'
    reference_url = 'https://github.com/pachterlab/kallisto-transcriptome-indices/releases/download/v1/human_index_standard.tar.xz'
    reference_archive = 'work/downloads/human_index_standard.tar.xz'
    reference_dir = 'references/human_ensembl108'
    index = 'references/human_ensembl108/index.idx'
    t2g = 'references/human_ensembl108/t2g.txt'
    full_counts = 'results/full/kb'
    test_counts = 'results/test/kb'
    full_fastqc = 'results/full/fastqc'
    test_fastqc = 'results/test/fastqc'
    // Stage 2 notebook parameters (full sample; exploratory QC)
    analysis_input = 'results/full/kb/counts_unfiltered/adata.h5ad'
    analysis_output = 'results/annotated.h5ad'
    analysis_dir = 'results/stage2'
    qc_min_genes = 200
    qc_max_genes = 5000
    qc_min_counts = 1000
    qc_max_counts = 30000
    qc_max_pct_mt = 20
    qc_gene_min_cells = 3
    normalization_target = 10000
    hvg_n_top_genes = 2000
    hvg_flavor = 'seurat'
    pca_components = 50
    pca_scale_clip = 10
    neighbors_n_pcs = 20
    neighbors_n_neighbors = 15
    leiden_resolution = 0.6
    leiden_iterations = 2
    umap_min_dist = 0.3
    marker_method = 'wilcoxon'
    marker_top_n = 4
    celltypist_model = 'references/celltypist/Immune_All_Low.pkl'
    celltypist_model_url = 'https://celltypist.cog.sanger.ac.uk/models/Pan_Immune_CellTypist/v2/Immune_All_Low.pkl'
    celltypist_model_sha256 = '290874d35dac039d4c9218c343fde4aac1077709b72a331ce7266f6828c36502'
    celltypist_overcluster_resolution = 5.0
    celltypist_min_prop = 0.5
    pbmc_markers = 'CD3E,IL7R,CD8A,MS4A1,CD79A,GNLY,NKG7,CD14,LYZ,FCGR3A,FCER1A,CST3'
    review_markers = 'CD3D,CD3E,TRAC,TRDC,TRGC2,CD8B,KLRD1,FCER1G,TYROBP,SLC4A10,KLRB1,LILRA4,CLEC4C,TCF4,GZMB,CD1C,CCR7,TCF7,LEF1,S100A8,S100A9'
}
